<Defs>

  <!-- Schwertgeist I: own non-humanlike race; natural attacks are taken from the original weapon Def at runtime. -->
  <ThingDef ParentName="BotchJob_UndeadAnimalBase">
    <defName>AR_SpiritRace01</defName>
    <label>Schwertgeist I</label>
    <description>Ein beschworener, körperloser Geisterkrieger. Trägt eine fest gebundene Waffe, aber keine wechselbare Kleidung und verrichtet keine Arbeit.</description>
    <statBases>
      <MoveSpeed>4.6</MoveSpeed>
      <FilthRate>0</FilthRate>
      <Wildness>0</Wildness>
      <RangedWeapon_Cooldown>2.4</RangedWeapon_Cooldown>
    </statBases>
    <race>
      <!-- ToolUser enables RimWorld's equipment tracker without a human backstory/work system. -->
      <intelligence>ToolUser</intelligence>
      <body>Human</body>
      <baseHealthScale>1.3</baseHealthScale>
      <baseBodySize>1</baseBodySize>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <trainability>None</trainability>
      <wildBiomes Inherit="False"/>
      <lifeStageAges><li><def>AnimalAdult</def><minAge>0</minAge></li></lifeStageAges>
    </race>
    <tools>
      <li><label>geisterhieb</label><capacities><li>Blunt</li></capacities><power>10</power><cooldownTime>2.4</cooldownTime></li>
    </tools>
    <comps>
      <li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.AnimalBehaviours.CompProperties_Draftable">
        <makeNonFleeingToo>true</makeNonFleeingToo>
      </li>
      <li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.AnimalBehaviours.CompProperties_Floating"/>
    </comps>
    <tradeTags Inherit="False"/>
    <butcherProducts Inherit="False"/>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>AR_GhostSpiritSword01</defName>
    <label>Schwertgeist I</label>
    <race>AR_SpiritRace01</race>
    <combatPower>150</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData><texPath>Things/Pawn/Animal/BotchJob_Wraith/BotchJob_Wraith</texPath><drawSize>1.51</drawSize></bodyGraphicData>
