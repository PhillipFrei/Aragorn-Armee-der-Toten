<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Permanently available rescue offer; explicitly generated by AragornRescueGame. -->
  <QuestScriptDef>
    <defName>AR_RescueAragornQuest</defName>
    <root Class="AragornArmy.QuestNode_PermanentAragorn" />
    <randomlySelectable>false</randomlySelectable>
    <autoAccept>false</autoAccept>
    <sendAvailableLetter>false</sendAvailableLetter>
    <!-- No expireDaysRange: QuestScriptDef already defaults to no expiry (-1,-1). -->
    <rootSelectionWeight>0</rootSelectionWeight>
  </QuestScriptDef>

  <!-- Site exists independent of a Profaned faction instance or settlement. -->
  <SitePartDef>
    <defName>AR_RescueCamp</defName>
    <label>Aragorns Gefängnis</label>
    <description>Ein verborgenes Lager, in dem Aragorn von den Profaned gefangen gehalten wird.</description>
    <workerClass>AragornArmy.SitePartWorker_AragornRescue</workerClass>
    <siteTexture>World/WorldObjects/ProfanedFactionIcon</siteTexture>
    <expandingIconTexture>World/WorldObjects/ProfanedFactionIcon</expandingIconTexture>
    <requiresFaction>false</requiresFaction>
    <showFactionInInspectString>false</showFactionInInspectString>
    <increasesPopulation>true</increasesPopulation>
    <wantsThreatPoints>true</wantsThreatPoints>
    <forceExitAndRemoveMapCountdownDurationDays>4</forceExitAndRemoveMapCountdownDurationDays>
  </SitePartDef>

  <!-- One sequential quest per liberated spirit; created by AragornGame.StartTrial. -->
  <QuestScriptDef>
    <defName>AR_GhostTrialQuest</defName>
    <root Class="AragornArmy.QuestNode_PermanentAragorn" />
    <randomlySelectable>false</randomlySelectable>
    <autoAccept>false</autoAccept>
    <sendAvailableLetter>false</sendAvailableLetter>
    <rootSelectionWeight>0</rootSelectionWeight>
  </QuestScriptDef>
  <SitePartDef>
    <defName>AR_GhostTrialCamp</defName>
    <label>Geisterkrypta</label>
    <description>Eine von Profaned-Wachen besetzte Krypta mit einem verfluchten Geisterkrieger.</description>
    <workerClass>AragornArmy.SitePartWorker_AragornTrial</workerClass>
    <siteTexture>World/WorldObjects/ProfanedFactionIcon</siteTexture>
    <expandingIconTexture>World/WorldObjects/ProfanedFactionIcon</expandingIconTexture>
    <requiresFaction>false</requiresFaction>
    <showFactionInInspectString>false</showFactionInInspectString>
    <increasesPopulation>true</increasesPopulation>
    <wantsThreatPoints>true</wantsThreatPoints>
    <forceExitAndRemoveMapCountdownDurationDays>4</forceExitAndRemoveMapCountdownDurationDays>
  </SitePartDef>

  <!-- Story quest that follows Aragorn's rescue. No quest expiration. -->
  <QuestScriptDef>
    <defName>AR_ReforgeAndurilQuest</defName>
    <root Class="AragornArmy.QuestNode_PermanentAragorn" />
    <randomlySelectable>false</randomlySelectable>
    <autoAccept>false</autoAccept>
    <sendAvailableLetter>false</sendAvailableLetter>
    <rootSelectionWeight>0</rootSelectionWeight>
  </QuestScriptDef>
  <SitePartDef>
    <defName>AR_AndurilForgeSite</defName>
    <label>goldene Schmiede der Divine Order</label>
    <description>Ein goldener Schmiedetempel, in dem die zerbrochene Klinge neu geschmiedet werden kann.</description>
    <workerClass>AragornArmy.SitePartWorker_AndurilForge</workerClass>
    <siteTexture>World/WorldObjects/DivineOrderIcon</siteTexture>
    <expandingIconTexture>World/WorldObjects/DivineOrderIcon</expandingIconTexture>
    <requiresFaction>false</requiresFaction>
    <showFactionInInspectString>false</showFactionInInspectString>
    <increasesPopulation>true</increasesPopulation>
    <wantsThreatPoints>true</wantsThreatPoints>
    <forceExitAndRemoveMapCountdownDurationDays>4</forceExitAndRemoveMapCountdownDurationDays>
  </SitePartDef>

  <!-- The smith performs the ritual; Aragorn has no crafting requirement. -->
  <JobDef>
    <defName>AR_WaitForAnduril</defName>
    <driverClass>AragornArmy.JobDriver_AragornWaitForAnduril</driverClass>
    <reportString>bewacht die Schmiede</reportString>
  </JobDef>
  <JobDef>
    <defName>AR_SmithAnduril</defName>
    <driverClass>AragornArmy.JobDriver_DivineOrderForgeAnduril</driverClass>
    <reportString>schmiedet Andúril</reportString>
  </JobDef>
</Defs>